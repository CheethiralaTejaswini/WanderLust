<% layout("/layouts/boilerplate") -%>

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
            <!-- Header Banner -->
            <div class="bg-warning text-dark p-4 text-center">
                <i class="fa-solid fa-taxi display-3 mb-2"></i>
                <h3 class="fw-bold mb-1">Cab Transfer Booked!</h3>
                <p class="mb-0 opacity-75">Your driver will meet you at the requested pickup location.</p>
            </div>

            <!-- Receipt Body -->
            <div class="card-body p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold d-block">Booking Reference</span>
                        <span class="fs-4 fw-bold text-dark font-monospace"><%= cabBooking.bookingCode %></span>
                    </div>
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2 fs-6">
                        <%= cabBooking.status %>
                    </span>
                </div>

                <!-- Ride Route Details -->
                <div class="mb-4 p-3 bg-light rounded-4 border">
                    <div class="d-flex align-items-start gap-3 mb-3">
                        <i class="fa-solid fa-circle text-success mt-1"></i>
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold d-block">Pickup Location</span>
                            <span class="fw-bold text-dark"><%= cabBooking.pickupLocation %></span>
                        </div>
                    </div>
                    <div class="d-flex align-items-start gap-3">
                        <i class="fa-solid fa-location-dot text-danger mt-1"></i>
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold d-block">Dropoff Destination</span>
                            <span class="fw-bold text-dark"><%= cabBooking.dropoffLocation %></span>
                        </div>
                    </div>
                </div>

                <!-- Trip Specs -->
                <div class="row g-2 mb-4 small">
                    <div class="col-6">
                        <div class="p-2 border rounded-3 bg-light">
                            <span class="text-muted d-block">Date</span>
                            <strong><%= (cabBooking.travelDate && !isNaN(new Date(cabBooking.travelDate).getTime())) ? new Date(cabBooking.travelDate).toLocaleDateString("en-IN", { month: "short", day: "numeric", year: "numeric" }) : 'N/A' %></strong>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 border rounded-3 bg-light">
                            <span class="text-muted d-block">Time</span>
                            <strong><%= cabBooking.pickupTime %></strong>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 border rounded-3 bg-light">
                            <span class="text-muted d-block">Vehicle</span>
                            <strong><%= cabBooking.cabType %></strong>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 border rounded-3 bg-light">
                            <span class="text-muted d-block">Passengers</span>
                            <strong><%= cabBooking.passengers %></strong>
                        </div>
                    </div>
                </div>

                <div class="mb-4 pb-3 border-bottom small">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Passenger Phone:</span>
                        <span class="fw-semibold text-dark"><%= cabBooking.contactPhone %></span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Approx. Distance:</span>
                        <span class="fw-semibold text-dark"><%= cabBooking.distanceKm %> km</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Estimated Duration:</span>
                        <span class="fw-semibold text-dark"><%= cabBooking.estimatedDuration %></span>
                    </div>
                </div>

                <!-- Fare Due -->
                <div class="d-flex justify-content-between align-items-center mb-4 p-3 bg-light rounded-4 border">
                    <div>
                        <span class="text-muted small text-uppercase d-block fw-semibold">Fare Due to Driver</span>
                        <span class="text-muted small">Fixed upfront rate (Cash/UPI)</span>
                    </div>
                    <span class="fs-3 fw-bold text-dark">&#8377;<%= Number(cabBooking.estimatedFare).toLocaleString("en-IN") %></span>
                </div>

                <!-- Actions -->
                <div class="d-flex gap-2">
                    <button class="btn btn-dark rounded-pill flex-grow-1 py-2 fw-semibold" onclick="window.print();">
                        <i class="fa-solid fa-print me-1"></i> Print Receipt
                    </button>
                    <a href="/profile#cabs" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                        My Rides
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
