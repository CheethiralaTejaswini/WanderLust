<% layout("/layouts/boilerplate") -%>

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-10 col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <div class="mb-4">
                <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-1 mb-2">Edit Listing</span>
                <h2 class="fw-bold mb-1">Update Listing Details</h2>
                <p class="text-muted small">Update information, pricing, or photos for "<%= listing.title %>".</p>
            </div>

            <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
                <!-- Title -->
                <div class="mb-3">
                    <label for="title" class="form-label fw-semibold">Title</label>
                    <input name="listing[title]" id="title" value="<%= listing.title %>" type="text" class="form-control rounded-3" required />
                    <div class="invalid-feedback">Please enter a valid title.</div>
                </div>

                <!-- Description -->
                <div class="mb-3">
                    <label for="description" class="form-label fw-semibold">Description</label>
                    <textarea name="listing[description]" id="description" rows="4" class="form-control rounded-3" required><%= listing.description %></textarea>
                    <div class="invalid-feedback">Please enter a valid description.</div>
                </div>

                <!-- Category & Property Type -->
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label for="category" class="form-label fw-semibold">Category</label>
                        <select name="listing[category]" id="category" class="form-select rounded-3">
                            <% for (let cat of categories) { %>
                                <option value="<%= cat.name %>" <%= listing.category === cat.name ? 'selected' : '' %>><%= cat.name %></option>
                            <% } %>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label for="accommodationType" class="form-label fw-semibold">Property Type</label>
                        <select name="listing[accommodationType]" id="accommodationType" class="form-select rounded-3">
                            <option value="Entire home" <%= listing.accommodationType === 'Entire home' ? 'selected' : '' %>>Entire home</option>
                            <option value="Private room" <%= listing.accommodationType === 'Private room' ? 'selected' : '' %>>Private room</option>
                            <option value="Shared room" <%= listing.accommodationType === 'Shared room' ? 'selected' : '' %>>Shared room</option>
                            <option value="Villa" <%= listing.accommodationType === 'Villa' ? 'selected' : '' %>>Villa</option>
                            <option value="Cabin" <%= listing.accommodationType === 'Cabin' ? 'selected' : '' %>>Cabin</option>
                            <option value="Resort" <%= listing.accommodationType === 'Resort' ? 'selected' : '' %>>Resort</option>
                        </select>
                    </div>
                </div>

                <!-- Current Image & Image Update -->
                <div class="mb-3 p-3 border rounded-3 bg-light">
                    <label class="form-label fw-semibold mb-2">Listing Image</label>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <img src="<%= originalImageUrl || listing.image?.url || 'https://images.unsplash.com/photo-1625505826533-5c80aca7d157?auto=format&fit=crop&w=400&q=60' %>" alt="Current image preview" class="rounded-3 shadow-sm" style="width: 120px; height: 80px; object-fit: cover;" />
                        <span class="small text-muted">Current image preview</span>
                    </div>
                    <div class="mb-2">
                        <label for="imageFile" class="form-label small text-muted">Replace with new image file (Cloudinary storage)</label>
                        <input id="imageFile" name="listing[image]" type="file" class="form-control rounded-3" accept="image/*">
                    </div>
                    <div class="text-center my-2 text-muted small fw-bold">OR</div>
                    <div>
                        <label for="imageUrl" class="form-label small text-muted">Update image URL</label>
                        <input id="imageUrl" name="listing[image][url]" type="text" class="form-control rounded-3" value="<%= listing.image?.url || '' %>" placeholder="https://images.unsplash.com/...">
                    </div>
                </div>

                <!-- Location & Country -->
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label for="location" class="form-label fw-semibold">Location / City</label>
                        <input name="listing[location]" id="location" value="<%= listing.location %>" type="text" class="form-control rounded-3" required />
                    </div>
                    <div class="col-md-6">
                        <label for="country" class="form-label fw-semibold">Country</label>
                        <input name="listing[country]" id="country" value="<%= listing.country %>" type="text" class="form-control rounded-3" required />
                    </div>
                </div>

                <!-- Price & Guest Capacity -->
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label for="price" class="form-label fw-semibold">Price per night (&#8377;)</label>
                        <input name="listing[price]" id="price" value="<%= listing.price %>" type="number" min="100" class="form-control rounded-3" required />
                    </div>
                    <div class="col-md-4">
                        <label for="maxGuests" class="form-label fw-semibold">Max Guests</label>
                        <input name="listing[maxGuests]" id="maxGuests" value="<%= listing.maxGuests || 4 %>" type="number" min="1" max="50" class="form-control rounded-3" required />
                    </div>
                    <div class="col-md-4">
                        <label for="bedrooms" class="form-label fw-semibold">Bedrooms</label>
                        <input name="listing[bedrooms]" id="bedrooms" value="<%= listing.bedrooms || 1 %>" type="number" min="1" max="20" class="form-control rounded-3" />
                    </div>
                </div>

                <!-- Amenities Checklist -->
                <div class="mb-4">
                    <label class="form-label fw-semibold">Amenities</label>
                    <div class="row row-cols-2 row-cols-md-3 g-2">
                        <% const availableAmenities = ["Wifi", "Air Conditioning", "Free Parking", "Pool", "Kitchen", "Dedicated Workspace", "TV", "Hot Tub", "Pet Friendly", "Breakfast"]; %>
                        <% for (let a of availableAmenities) { %>
                            <div class="col">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="listing[amenities]" value="<%= a %>" id="am-edit-<%= a.replace(/\s+/g, '') %>"
                                        <%= (listing.amenities && listing.amenities.includes(a)) ? 'checked' : '' %>>
                                    <label class="form-check-label small" for="am-edit-<%= a.replace(/\s+/g, '') %>">
                                        <%= a %>
                                    </label>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger rounded-pill px-5 py-2 fw-semibold">
                        Save Changes
                    </button>
                    <a href="/listings/<%= listing._id %>" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
