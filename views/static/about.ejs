<% layout("/layouts/boilerplate") -%>

<div class="row justify-content-center py-5">
    <div class="col-12 col-md-10 col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-1 mb-3 align-self-start">About Wanderlust</span>
            <h1 class="fw-bold mb-3">Redefining How the World Travels</h1>
            <p class="lead text-secondary mb-4">
                Wanderlust is a modern vacation rental and travel experiences platform inspired by Airbnb, engineered to connect curious wanderers with unforgettable stays and seamless transportation worldwide.
            </p>
            <div class="row g-4 my-3">
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-4 border h-100">
                        <i class="fa-solid fa-house-chimney text-danger fs-3 mb-2"></i>
                        <h6 class="fw-bold">Handcrafted Stays</h6>
                        <p class="text-muted small mb-0">From beachfront cottages to mountain cabins, find spaces curated for comfort and memories.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-4 border h-100">
                        <i class="fa-solid fa-map-location-dot text-primary fs-3 mb-2"></i>
                        <h6 class="fw-bold">Map & Discovery</h6>
                        <p class="text-muted small mb-0">Explore destinations with Google Maps integration, driving directions, and local restaurant guides.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-4 border h-100">
                        <i class="fa-solid fa-taxi text-warning fs-3 mb-2"></i>
                        <h6 class="fw-bold">Seamless Transfers</h6>
                        <p class="text-muted small mb-0">Reserve verified cab transfers directly or link out to partner rides with zero confusion.</p>
                    </div>
                </div>
            </div>
            <div class="pt-4 border-top mt-4">
                <a href="/listings" class="btn btn-danger rounded-pill px-4 fw-semibold">Start Exploring Stays</a>
            </div>
        </div>
    </div>
</div>
