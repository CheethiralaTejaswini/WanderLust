<% layout("/layouts/boilerplate") -%>

<div class="row justify-content-center py-5">
    <div class="col-12 col-md-10 col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-1 mb-3 align-self-start">Terms of Service</span>
            <h2 class="fw-bold mb-3">Terms & Conditions</h2>
            <p class="text-secondary">
                By accessing or using Wanderlust, you agree to comply with our community guidelines, booking regulations, and platform safety standards.
            </p>
            <h5 class="fw-bold mt-4">1. Booking Integrity</h5>
            <p class="text-muted small">
                Reservations are held based on confirmed check-in and check-out dates. Double bookings are prevented by our automated availability tracking engine.
            </p>
            <h5 class="fw-bold mt-4">2. Host & Guest Responsibilities</h5>
            <p class="text-muted small">
                Hosts agree to provide accurate accommodation descriptions, amenities, and location details. Guests agree to treat properties with respect and follow house rules.
            </p>
            <h5 class="fw-bold mt-4">3. Cab & Transportation Booking</h5>
            <p class="text-muted small">
                Transportation services are provided as estimated transfers or directly through partner providers. Fares are transparent and agreed upon upfront.
            </p>
            <div class="pt-4 border-top mt-4">
                <a href="/listings" class="btn btn-outline-dark rounded-pill px-4">Back to Home</a>
            </div>
        </div>
    </div>
</div>
