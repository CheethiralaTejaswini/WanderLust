<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <% if (typeof success !== "undefined" && success && success.length > 0) { %>
            <div class="alert alert-success alert-dismissible fade show modern-alert shadow-sm d-flex align-items-center" role="alert">
                <i class="fa-solid fa-circle-check me-2 fs-5"></i>
                <div class="flex-grow-1"><%- success[0] %></div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <% if (typeof error !== "undefined" && error && error.length > 0) { %>
            <div class="alert alert-danger alert-dismissible fade show modern-alert shadow-sm d-flex align-items-center" role="alert">
                <i class="fa-solid fa-circle-exclamation me-2 fs-5"></i>
                <div class="flex-grow-1"><%- error[0] %></div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>
    </div>
</div>
