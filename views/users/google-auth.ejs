<% layout("/layouts/boilerplate") -%>

<div class="row justify-content-center py-5">
    <div class="col-12 col-sm-10 col-md-7 col-lg-5">
        <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white text-center">
            <!-- Google Logo -->
            <div class="mb-3">
                <svg width="48" height="48" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
                    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
                </svg>
            </div>

            <h3 class="fw-bold mb-1">Sign in with Google</h3>
            <p class="text-muted small mb-4">Choose or enter your Gmail account to continue to Wanderlust</p>

            <form action="/auth/google/direct-login" method="POST" novalidate class="needs-validation text-start">
                <div class="mb-3">
                    <label for="gmailInput" class="form-label small fw-semibold text-muted text-uppercase">Gmail / Google Email</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fa-solid fa-envelope text-danger"></i></span>
                        <input
                            type="email"
                            name="email"
                            id="gmailInput"
                            class="form-control py-2 rounded-end-3"
                            placeholder="yourname@gmail.com"
                            pattern="^[^@\s]+@[^@\s]+\.[^@\s]+$"
                            required
                            autofocus
                        />
                    </div>
                    <div class="invalid-feedback">Please enter a valid Gmail / Google email address (e.g. name@gmail.com).</div>
                </div>

                <div class="mb-4">
                    <label for="nameInput" class="form-label small fw-semibold text-muted text-uppercase">Your Full Name</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fa-solid fa-user text-primary"></i></span>
                        <input
                            type="text"
                            name="displayName"
                            id="nameInput"
                            class="form-control py-2 rounded-end-3"
                            placeholder="e.g. John Doe"
                        />
                    </div>
                    <div class="form-text small">This will be shown on your profile and bookings.</div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-sm mb-3 d-flex align-items-center justify-content-center gap-2" style="background-color: #1a73e8; border-color: #1a73e8;">
                    <span>Sign in with Google</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </button>

                <div class="text-center">
                    <a href="/login" class="text-muted small text-decoration-none">
                        &larr; Back to standard login
                    </a>
                </div>
            </form>

            <!-- Developer Notice Banner -->
            <div class="mt-4 p-3 bg-light rounded-4 text-start border small">
                <div class="d-flex align-items-center gap-2 mb-1 text-dark fw-bold">
                    <i class="fa-solid fa-circle-info text-primary"></i> Google OAuth Integration Note
                </div>
                <p class="text-muted mb-0 small" style="line-height: 1.5;">
                    Sign in with any Gmail address above. To switch to live Google Cloud popup authentication, add your <code>GOOGLE_CLIENT_ID</code> and <code>GOOGLE_CLIENT_SECRET</code> to your <code>.env</code> file.
                </p>
            </div>
        </div>
    </div>
</div>
