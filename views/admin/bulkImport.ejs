<% layout("/layouts/boilerplate") -%>

<div class="admin-container py-3">
    <!-- Header with Breadcrumbs & Title -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a href="/listings" class="text-decoration-none text-muted">Home</a></li>
                    <li class="breadcrumb-item"><a href="/profile" class="text-decoration-none text-muted">Dashboard</a></li>
                    <li class="breadcrumb-item active text-danger fw-bold" aria-current="page">Admin Bulk Import & Export</li>
                </ol>
            </nav>
            <h2 class="fw-bold mb-1 text-dark d-flex align-items-center gap-2">
                <i class="fa-solid fa-file-import text-danger"></i> Bulk Data Management System
            </h2>
            <p class="text-muted small mb-0">Upload and validate high-volume listings and reviews using CSV or Excel spreadsheets.</p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-2 small">
                <i class="fa-solid fa-shield-halved me-1"></i> Admin Privileges Active
            </span>
            <a href="/listings" class="btn btn-outline-dark btn-sm rounded-pill px-3">
                <i class="fa-solid fa-arrow-left me-1"></i> Back to Explore
            </a>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="row row-cols-1 row-cols-sm-3 g-3 mb-4">
        <div class="col">
            <div class="card border rounded-4 shadow-sm p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Total Listings</div>
                        <h3 class="fw-bold mb-0 text-dark mt-1"><%= totalListings %></h3>
                    </div>
                    <div class="rounded-circle bg-danger-subtle text-danger p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                        <i class="fa-solid fa-house-chimney fs-5"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card border rounded-4 shadow-sm p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Total Reviews</div>
                        <h3 class="fw-bold mb-0 text-dark mt-1"><%= totalReviews %></h3>
                    </div>
                    <div class="rounded-circle bg-warning-subtle text-warning p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                        <i class="fa-solid fa-star fs-5"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card border rounded-4 shadow-sm p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Registered Users</div>
                        <h3 class="fw-bold mb-0 text-dark mt-1"><%= totalUsers %></h3>
                    </div>
                    <div class="rounded-circle bg-primary-subtle text-primary p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                        <i class="fa-solid fa-users fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Navigation Tabs -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden mb-4">
        <div class="card-header bg-white border-bottom p-0">
            <ul class="nav nav-tabs border-0 px-3 pt-2" id="importTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active fw-bold border-0 py-3 px-4 text-dark" id="listings-import-tab" data-bs-toggle="tab" data-bs-target="#listings-import-pane" type="button" role="tab">
                        <i class="fa-solid fa-house-chimney me-2 text-danger"></i> Bulk Import Listings
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-bold border-0 py-3 px-4 text-dark" id="reviews-import-tab" data-bs-toggle="tab" data-bs-target="#reviews-import-pane" type="button" role="tab">
                        <i class="fa-solid fa-star me-2 text-warning"></i> Bulk Import Reviews
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-bold border-0 py-3 px-4 text-dark" id="export-tab" data-bs-toggle="tab" data-bs-target="#export-pane" type="button" role="tab">
                        <i class="fa-solid fa-file-export me-2 text-primary"></i> Export Listings & Data
                    </button>
                </li>
            </ul>
        </div>

        <div class="card-body p-4">
            <div class="tab-content" id="importTabsContent">
                <!-- ==========================================
                     TAB 1: BULK IMPORT LISTINGS
                     ========================================== -->
                <div class="tab-pane fade show active" id="listings-import-pane" role="tabpanel">
                    <!-- Step 1: Download Templates Banner -->
                    <div class="p-3 bg-light rounded-4 border mb-4">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                            <div>
                                <h6 class="fw-bold mb-1 text-dark">
                                    <i class="fa-solid fa-download text-danger me-2"></i> Step 1: Download Sample Template
                                </h6>
                                <p class="text-muted small mb-0">Use our pre-formatted spreadsheet template with predefined column headers to prevent formatting errors.</p>
                            </div>
                            <div class="d-flex gap-2">
                                <a href="/admin/bulk-import/template?type=listings&format=csv" class="btn btn-sm btn-outline-dark rounded-pill px-3 fw-semibold">
                                    <i class="fa-solid fa-file-csv me-1 text-success"></i> Download CSV Template
                                </a>
                                <a href="/admin/bulk-import/template?type=listings&format=xlsx" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-semibold">
                                    <i class="fa-solid fa-file-excel me-1 text-success"></i> Download Excel (.xlsx)
                                </a>
                            </div>
                        </div>

                        <!-- Column Guidelines Accordion -->
                        <div class="mt-3 pt-2 border-top">
                            <a class="text-decoration-none small fw-semibold text-secondary d-inline-flex align-items-center gap-1" data-bs-toggle="collapse" href="#columnsHelp" role="button">
                                <i class="fa-solid fa-circle-info"></i> View Required & Optional Columns Guidelines &darr;
                            </a>
                            <div class="collapse mt-2" id="columnsHelp">
                                <div class="bg-white p-3 rounded-3 border small">
                                    <div class="row g-2">
                                        <div class="col-md-6">
                                            <strong>Required Columns:</strong>
                                            <ul class="mb-2 text-muted ps-3">
                                                <li><code>Title</code> &ndash; Min 3 characters (e.g. <em>Sunset Palms Villa</em>)</li>
                                                <li><code>Description</code> &ndash; Min 10 characters describing the stay</li>
                                                <li><code>Price</code> &ndash; Positive number per night in INR (e.g. <em>3500</em>)</li>
                                                <li><code>Location</code> &ndash; City / Destination name (e.g. <em>Goa</em>, <em>Manali</em>)</li>
                                                <li><code>Country</code> &ndash; Country name (default: <em>India</em>)</li>
                                            </ul>
                                        </div>
                                        <div class="col-md-6">
                                            <strong>Optional Columns:</strong>
                                            <ul class="mb-0 text-muted ps-3">
                                                <li><code>Category</code> &ndash; Trending, Beaches, Mountains, Iconic Cities, Rooms, Castles, Villas, etc.</li>
                                                <li><code>Property Type</code> &ndash; Entire home, Private room, Villa, Cabin, Resort</li>
                                                <li><code>Amenities</code> &ndash; Comma-separated (e.g. <em>Wifi, Pool, Kitchen</em>)</li>
                                                <li><code>Max Guests</code>, <code>Bedrooms</code>, <code>Beds</code>, <code>Bathrooms</code></li>
                                                <li><code>Image URL</code> &ndash; Direct image link (falls back to default if blank)</li>
                                                <li><code>Latitude</code>, <code>Longitude</code> &ndash; (automatically geocoded if omitted)</li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Step 2: Upload File & Duplicate Strategy Form -->
                    <form id="listingsUploadForm" class="mb-4" enctype="multipart/form-data">
                        <input type="hidden" name="importType" value="listings" />

                        <div class="row g-3 mb-3">
                            <div class="col-md-8">
                                <label class="form-label fw-bold text-dark small text-uppercase">
                                    Step 2: Choose Spreadsheet File (.csv or .xlsx)
                                </label>
                                <!-- Drag & Drop Zone -->
                                <div class="drop-zone border border-2 border-dashed rounded-4 p-4 text-center bg-light" id="listingsDropZone">
                                    <i class="fa-solid fa-cloud-arrow-up display-5 text-danger mb-2"></i>
                                    <h6 class="fw-bold mb-1">Drag and drop your file here, or click to browse</h6>
                                    <p class="text-muted small mb-2">Supports CSV (.csv) and Excel (.xlsx, .xls) files up to 10 MB</p>
                                    <input type="file" id="listingsFileInput" name="file" accept=".csv, .xlsx, .xls" class="d-none" required />
                                    <button type="button" class="btn btn-outline-dark btn-sm rounded-pill px-4" onclick="document.getElementById('listingsFileInput').click();">
                                        Browse File
                                    </button>
                                    <div id="listingsFileFeedback" class="mt-2 fw-semibold text-success small d-none"></div>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-bold text-dark small text-uppercase">
                                    Duplicate Detection Strategy
                                </label>
                                <div class="card border rounded-4 p-3 bg-light h-100">
                                    <p class="text-muted small mb-2">Configure how Wanderlust handles listings that already exist in the database (matched by Title & Location):</p>
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="radio" name="duplicateStrategy" id="stratSkip" value="skip" checked>
                                        <label class="form-check-label small fw-semibold" for="stratSkip">
                                            Skip Duplicates <span class="badge bg-success-subtle text-success small">Recommended</span>
                                            <div class="text-muted fw-normal text-xs">Ignore duplicate rows and keep original listings untouched.</div>
                                        </label>
                                    </div>
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="radio" name="duplicateStrategy" id="stratUpdate" value="update">
                                        <label class="form-check-label small fw-semibold" for="stratUpdate">
                                            Update Existing Listings
                                            <div class="text-muted fw-normal text-xs">Overwrite pricing, description, and details for matching stays.</div>
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="duplicateStrategy" id="stratAllow" value="allow">
                                        <label class="form-check-label small fw-semibold" for="stratAllow">
                                            Allow Duplicates
                                            <div class="text-muted fw-normal text-xs">Import all valid records as new listings.</div>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Action Button -->
                        <div class="d-flex align-items-center gap-3">
                            <button type="submit" id="btnPreviewListings" class="btn btn-danger rounded-pill px-4 py-2 fw-semibold shadow-sm">
                                <i class="fa-solid fa-magnifying-glass-chart me-1"></i> Upload & Validate Records
                            </button>
                            <button type="button" id="btnClearListings" class="btn btn-outline-secondary rounded-pill px-3 py-2 btn-sm d-none">
                                Clear
                            </button>
                            <div id="listingsValidationSpinner" class="spinner-border text-danger spinner-border-sm d-none" role="status">
                                <span class="visually-hidden">Validating...</span>
                            </div>
                        </div>
                    </form>

                    <!-- Step 3: Interactive Preview & Validation Table Container -->
                    <div id="listingsPreviewSection" class="d-none">
                        <hr class="my-4" />

                        <!-- Summary Counter Banner -->
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3 p-3 bg-light rounded-4 border">
                            <div>
                                <h5 class="fw-bold mb-1 text-dark">
                                    <i class="fa-solid fa-list-check text-primary me-2"></i> Validation Preview Results
                                </h5>
                                <span class="text-muted small" id="previewFileName"></span>
                            </div>

                            <!-- Metrics Badges -->
                            <div class="d-flex flex-wrap gap-2">
                                <span class="badge bg-secondary rounded-pill px-3 py-2 fs-6 fw-semibold" id="countTotal">Total: 0</span>
                                <span class="badge bg-success rounded-pill px-3 py-2 fs-6 fw-semibold" id="countValid">Valid: 0</span>
                                <span class="badge bg-warning text-dark rounded-pill px-3 py-2 fs-6 fw-semibold" id="countDuplicates">Duplicates: 0</span>
                                <span class="badge bg-danger rounded-pill px-3 py-2 fs-6 fw-semibold" id="countInvalid">Invalid: 0</span>
                            </div>
                        </div>

                        <!-- Table Filter Buttons & Action Bar -->
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                            <div class="btn-group btn-group-sm rounded-pill border p-1 bg-white" role="group">
                                <button type="button" class="btn btn-dark rounded-pill active" onclick="filterPreviewRows('all', this)">All Rows</button>
                                <button type="button" class="btn btn-outline-secondary rounded-pill border-0" onclick="filterPreviewRows('valid', this)">Valid Only</button>
                                <button type="button" class="btn btn-outline-secondary rounded-pill border-0" onclick="filterPreviewRows('invalid', this)">Invalid Only</button>
                                <button type="button" class="btn btn-outline-secondary rounded-pill border-0" onclick="filterPreviewRows('duplicate', this)">Duplicates</button>
                            </div>

                            <div class="d-flex gap-2">
                                <a id="btnDownloadErrorReport" href="#" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-semibold d-none">
                                    <i class="fa-solid fa-file-circle-exclamation me-1"></i> Download Failed Rows Report (.csv)
                                </a>
                                <button type="button" id="btnConfirmImportListings" class="btn btn-success rounded-pill px-4 fw-semibold shadow-sm">
                                    <i class="fa-solid fa-check-double me-1"></i> Proceed with Import (<span id="btnImportCount">0</span> Records)
                                </button>
                            </div>
                        </div>

                        <!-- Preview Table -->
                        <div class="table-responsive border rounded-4 shadow-sm bg-white mb-3" style="max-height: 480px;">
                            <table class="table table-hover align-middle mb-0 small text-nowrap" id="listingsTable">
                                <thead class="table-dark sticky-top">
                                    <tr>
                                        <th style="width: 70px;">Row #</th>
                                        <th style="width: 110px;">Status</th>
                                        <th>Title</th>
                                        <th>Location, Country</th>
                                        <th>Price / Night</th>
                                        <th>Category</th>
                                        <th>Type</th>
                                        <th>Validation Remarks</th>
                                    </tr>
                                </thead>
                                <tbody id="listingsTableBody">
                                    <!-- Rendered dynamically via JavaScript -->
                                </tbody>
                            </table>
                        </div>

                        <!-- Step 4: Progress Bar & Result Banner -->
                        <div id="importProgressBox" class="p-4 rounded-4 border bg-light d-none mt-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold text-dark" id="importProgressStatus">Importing valid records into MongoDB...</span>
                                <span class="fw-bold text-danger" id="importProgressPercent">0%</span>
                            </div>
                            <div class="progress rounded-pill mb-2" style="height: 12px;">
                                <div id="importProgressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-danger" role="progressbar" style="width: 0%"></div>
                            </div>
                        </div>

                        <!-- Final Summary Banner -->
                        <div id="importFinalResult" class="alert alert-success border rounded-4 p-4 shadow-sm d-none mt-3">
                            <div class="d-flex align-items-start gap-3">
                                <i class="fa-solid fa-circle-check fs-2 text-success mt-1"></i>
                                <div class="flex-grow-1">
                                    <h5 class="alert-heading fw-bold mb-1">Bulk Import Successfully Completed!</h5>
                                    <p class="mb-2" id="finalResultText"></p>
                                    <div class="d-flex gap-2 mt-3">
                                        <a href="/listings" class="btn btn-danger rounded-pill px-4 btn-sm fw-semibold">
                                            <i class="fa-solid fa-compass me-1"></i> Explore New Listings
                                        </a>
                                        <button type="button" class="btn btn-outline-dark rounded-pill px-3 btn-sm" onclick="location.reload();">
                                            Import Another Batch
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ==========================================
                     TAB 2: BULK IMPORT REVIEWS
                     ========================================== -->
                <div class="tab-pane fade" id="reviews-import-pane" role="tabpanel">
                    <div class="p-3 bg-light rounded-4 border mb-4">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                            <div>
                                <h6 class="fw-bold mb-1 text-dark">
                                    <i class="fa-solid fa-download text-warning me-2"></i> Reviews Import Templates
                                </h6>
                                <p class="text-muted small mb-0">Import traveler reviews and ratings matched against existing listings in the database.</p>
                            </div>
                            <div class="d-flex gap-2">
                                <a href="/admin/bulk-import/template?type=reviews&format=csv" class="btn btn-sm btn-outline-dark rounded-pill px-3 fw-semibold">
                                    <i class="fa-solid fa-file-csv me-1 text-success"></i> Sample CSV
                                </a>
                                <a href="/admin/bulk-import/template?type=reviews&format=xlsx" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-semibold">
                                    <i class="fa-solid fa-file-excel me-1 text-success"></i> Sample Excel (.xlsx)
                                </a>
                            </div>
                        </div>
                    </div>

                    <form id="reviewsUploadForm" class="mb-4" enctype="multipart/form-data">
                        <input type="hidden" name="importType" value="reviews" />
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark small text-uppercase">Upload Reviews File</label>
                            <input type="file" id="reviewsFileInput" name="file" accept=".csv, .xlsx, .xls" class="form-control rounded-3" required />
                            <div class="form-text small">Upload CSV or Excel file containing: Listing Title or ID, Rating (1-5), and Comment.</div>
                        </div>

                        <button type="submit" id="btnPreviewReviews" class="btn btn-warning text-dark rounded-pill px-4 fw-semibold shadow-sm">
                            <i class="fa-solid fa-magnifying-glass me-1"></i> Validate & Preview Reviews
                        </button>
                    </form>

                    <!-- Reviews Preview Container -->
                    <div id="reviewsPreviewSection" class="d-none">
                        <hr class="my-4" />
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-bold mb-0">Reviews Validation Table</h5>
                            <button type="button" id="btnConfirmImportReviews" class="btn btn-success rounded-pill px-4 btn-sm fw-semibold">
                                Import Valid Reviews (<span id="reviewsImportCount">0</span>)
                            </button>
                        </div>
                        <div class="table-responsive border rounded-4 bg-white" style="max-height: 400px;">
                            <table class="table table-hover align-middle mb-0 small text-nowrap" id="reviewsTable">
                                <thead class="table-dark sticky-top">
                                    <tr>
                                        <th>Row #</th>
                                        <th>Status</th>
                                        <th>Target Listing</th>
                                        <th>Rating</th>
                                        <th>Comment</th>
                                        <th>Author</th>
                                        <th>Remarks</th>
                                    </tr>
                                </thead>
                                <tbody id="reviewsTableBody"></tbody>
                            </table>
                        </div>
                        <div id="reviewsFinalResult" class="alert alert-success border rounded-4 p-3 shadow-sm d-none mt-3"></div>
                    </div>
                </div>

                <!-- ==========================================
                     TAB 3: EXPORT LISTINGS & DATA
                     ========================================== -->
                <div class="tab-pane fade" id="export-pane" role="tabpanel">
                    <div class="p-4 bg-light rounded-4 border">
                        <h5 class="fw-bold text-dark mb-1">
                            <i class="fa-solid fa-file-export text-primary me-2"></i> Export Stays & Experiences
                        </h5>
                        <p class="text-muted small mb-4">Export all current Wanderlust listings to spreadsheet formats. Formula injection protection is applied automatically.</p>

                        <div class="row g-3 align-items-end mb-4">
                            <div class="col-md-5">
                                <label class="form-label fw-bold text-dark small text-uppercase">Filter by Category</label>
                                <select id="exportCategorySelect" class="form-select rounded-3">
                                    <option value="All">All Categories (Entire Catalog)</option>
                                    <% for (let cat of categories) { %>
                                        <option value="<%= cat.name %>"><%= cat.name %></option>
                                    <% } %>
                                </select>
                            </div>

                            <div class="col-md-7 d-flex flex-wrap gap-2">
                                <button type="button" class="btn btn-outline-dark rounded-pill px-4 fw-semibold" onclick="triggerExport('csv');">
                                    <i class="fa-solid fa-file-csv text-success me-1"></i> Export to CSV
                                </button>
                                <button type="button" class="btn btn-danger rounded-pill px-4 fw-semibold shadow-sm" onclick="triggerExport('xlsx');">
                                    <i class="fa-solid fa-file-excel me-1"></i> Export to Excel (.xlsx)
                                </button>
                            </div>
                        </div>

                        <div class="alert alert-light border rounded-3 p-3 small text-muted mb-0">
                            <i class="fa-solid fa-shield-halved text-success me-1"></i> <strong>Security Standard:</strong> All cell values starting with symbols (<code>=</code>, <code>+</code>, <code>-</code>, <code>@</code>) are automatically neutralized against formula execution attacks.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Client-side Interactive JavaScript for Drag & Drop, AJAX Validation, Preview, & Progress -->
<script>
    let currentBatchId = null;
    let currentBatchData = null;

    document.addEventListener("DOMContentLoaded", () => {
        // Drag and Drop support
        const dropZone = document.getElementById("listingsDropZone");
        const fileInput = document.getElementById("listingsFileInput");
        const fileFeedback = document.getElementById("listingsFileFeedback");
        const btnClear = document.getElementById("btnClearListings");

        if (dropZone && fileInput) {
            ["dragenter", "dragover"].forEach(evtName => {
                dropZone.addEventListener(evtName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropZone.classList.add("bg-danger-subtle", "border-danger");
                });
            });

            ["dragleave", "drop"].forEach(evtName => {
                dropZone.addEventListener(evtName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropZone.classList.remove("bg-danger-subtle", "border-danger");
                });
            });

            dropZone.addEventListener("drop", (e) => {
                if (e.dataTransfer && e.dataTransfer.files.length > 0) {
                    fileInput.files = e.dataTransfer.files;
                    handleFileSelection(fileInput.files[0]);
                }
            });

            fileInput.addEventListener("change", () => {
                if (fileInput.files.length > 0) {
                    handleFileSelection(fileInput.files[0]);
                }
            });
        }

        function handleFileSelection(file) {
            fileFeedback.classList.remove("d-none");
            const sizeKb = (file.size / 1024).toFixed(1);
            fileFeedback.innerHTML = `<i class="fa-solid fa-file me-1"></i> Selected: <strong>${file.name}</strong> (${sizeKb} KB)`;
            btnClear.classList.remove("d-none");
        }

        if (btnClear) {
            btnClear.addEventListener("click", () => {
                fileInput.value = "";
                fileFeedback.classList.add("d-none");
                fileFeedback.innerHTML = "";
                btnClear.classList.add("d-none");
                document.getElementById("listingsPreviewSection").classList.add("d-none");
            });
        }

        // Listings Preview Submit Handler
        const listingsUploadForm = document.getElementById("listingsUploadForm");
        if (listingsUploadForm) {
            listingsUploadForm.addEventListener("submit", async (e) => {
                e.preventDefault();
                if (!fileInput.files || fileInput.files.length === 0) {
                    alert("Please select a CSV or Excel file to upload.");
                    return;
                }

                const btnPreview = document.getElementById("btnPreviewListings");
                const spinner = document.getElementById("listingsValidationSpinner");
                btnPreview.disabled = true;
                spinner.classList.remove("d-none");

                const formData = new FormData(listingsUploadForm);

                try {
                    const res = await fetch("/admin/bulk-import/preview", {
                        method: "POST",
                        body: formData
                    });
                    const result = await res.json();

                    if (!result.success) {
                        alert("Validation error: " + (result.message || "Unable to parse file."));
                        return;
                    }

                    renderListingsPreview(result);
                } catch (err) {
                    alert("Network error while validating file: " + err.message);
                } finally {
                    btnPreview.disabled = false;
                    spinner.classList.add("d-none");
                }
            });
        }

        // Listings Confirm Import Button Handler
        const btnConfirmImportListings = document.getElementById("btnConfirmImportListings");
        if (btnConfirmImportListings) {
            btnConfirmImportListings.addEventListener("click", async () => {
                if (!currentBatchId) {
                    alert("No active validated batch found.");
                    return;
                }

                const stratEl = document.querySelector('input[name="duplicateStrategy"]:checked');
                const duplicateStrategy = stratEl ? stratEl.value : "skip";

                const progressBox = document.getElementById("importProgressBox");
                const progressBar = document.getElementById("importProgressBar");
                const progressStatus = document.getElementById("importProgressStatus");
                const progressPercent = document.getElementById("importProgressPercent");
                const finalResult = document.getElementById("importFinalResult");

                progressBox.classList.remove("d-none");
                finalResult.classList.add("d-none");
                btnConfirmImportListings.disabled = true;

                // Simulate progress animation during backend processing
                let progress = 10;
                const timer = setInterval(() => {
                    progress = Math.min(progress + 15, 90);
                    progressBar.style.width = progress + "%";
                    progressPercent.innerText = progress + "%";
                }, 150);

                try {
                    const res = await fetch("/admin/bulk-import/confirm", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ batchId: currentBatchId, duplicateStrategy })
                    });
                    const data = await res.json();

                    clearInterval(timer);
                    progressBar.style.width = "100%";
                    progressPercent.innerText = "100%";

                    setTimeout(() => {
                        progressBox.classList.add("d-none");
                        finalResult.classList.remove("d-none");
                        document.getElementById("finalResultText").innerHTML = data.message;
                    }, 500);
                } catch (err) {
                    clearInterval(timer);
                    progressBox.classList.add("d-none");
                    alert("Error saving records to database: " + err.message);
                    btnConfirmImportListings.disabled = false;
                }
            });
        }

        // Reviews Preview Submit Handler
        const reviewsUploadForm = document.getElementById("reviewsUploadForm");
        if (reviewsUploadForm) {
            reviewsUploadForm.addEventListener("submit", async (e) => {
                e.preventDefault();
                const fileInputRev = document.getElementById("reviewsFileInput");
                if (!fileInputRev.files || fileInputRev.files.length === 0) {
                    alert("Please select a file.");
                    return;
                }

                const formData = new FormData(reviewsUploadForm);
                const res = await fetch("/admin/bulk-import/preview", {
                    method: "POST",
                    body: formData
                });
                const result = await res.json();
                if (!result.success) {
                    alert("Validation error: " + result.message);
                    return;
                }
                renderReviewsPreview(result);
            });
        }

        // Reviews Confirm Import Button Handler
        const btnConfirmImportReviews = document.getElementById("btnConfirmImportReviews");
        if (btnConfirmImportReviews) {
            btnConfirmImportReviews.addEventListener("click", async () => {
                if (!currentBatchId) return;
                btnConfirmImportReviews.disabled = true;
                const res = await fetch("/admin/bulk-import/confirm", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ batchId: currentBatchId, duplicateStrategy: "allow" })
                });
                const data = await res.json();
                const resBox = document.getElementById("reviewsFinalResult");
                resBox.classList.remove("d-none");
                resBox.innerText = data.message;
            });
        }
    });

    function renderListingsPreview(result) {
        currentBatchId = result.batchId;
        currentBatchData = result;

        const previewSection = document.getElementById("listingsPreviewSection");
        previewSection.classList.remove("d-none");

        document.getElementById("previewFileName").innerText = "File: " + result.fileName;
        document.getElementById("countTotal").innerText = "Total: " + result.summary.total;
        document.getElementById("countValid").innerText = "Valid: " + result.summary.valid;
        document.getElementById("countDuplicates").innerText = "Duplicates: " + result.summary.duplicates;
        document.getElementById("countInvalid").innerText = "Invalid: " + result.summary.invalid;

        const stratEl = document.querySelector('input[name="duplicateStrategy"]:checked');
        const strat = stratEl ? stratEl.value : "skip";
        const importCount = strat === "skip" ? result.summary.cleanValid : result.summary.valid;
        document.getElementById("btnImportCount").innerText = importCount;

        // Download Error Report button visibility
        const btnErrorReport = document.getElementById("btnDownloadErrorReport");
        if (result.summary.invalid > 0) {
            btnErrorReport.classList.remove("d-none");
            btnErrorReport.href = `/admin/bulk-import/error-report/${result.batchId}?format=csv`;
        } else {
            btnErrorReport.classList.add("d-none");
        }

        // Render Table Rows
        const tbody = document.getElementById("listingsTableBody");
        tbody.innerHTML = "";

        result.preview.forEach(row => {
            const tr = document.createElement("tr");
            let statusBadge = "";
            let rowTypeClass = "";

            if (!row.isValid) {
                statusBadge = '<span class="badge bg-danger rounded-pill"><i class="fa-solid fa-xmark me-1"></i> Invalid</span>';
                rowTypeClass = "table-row-invalid";
            } else if (row.isDuplicate) {
                statusBadge = '<span class="badge bg-warning text-dark rounded-pill"><i class="fa-solid fa-copy me-1"></i> Duplicate</span>';
                rowTypeClass = "table-row-duplicate";
            } else {
                statusBadge = '<span class="badge bg-success rounded-pill"><i class="fa-solid fa-check me-1"></i> Valid</span>';
                rowTypeClass = "table-row-valid";
            }

            tr.className = rowTypeClass;

            const remarks = [];
            if (row.errors && row.errors.length > 0) {
                remarks.push('<span class="text-danger fw-semibold"><i class="fa-solid fa-triangle-exclamation me-1"></i>' + row.errors.join("; ") + '</span>');
            }
            if (row.duplicateReason) {
                remarks.push('<span class="text-warning-emphasis"><i class="fa-solid fa-copy me-1"></i>' + row.duplicateReason + '</span>');
            }
            if (row.warnings && row.warnings.length > 0) {
                remarks.push('<span class="text-muted"><i class="fa-solid fa-info-circle me-1"></i>' + row.warnings.join("; ") + '</span>');
            }

            tr.innerHTML = `
                <td class="fw-bold">${row.rowIndex}</td>
                <td>${statusBadge}</td>
                <td class="fw-semibold text-truncate" style="max-width: 220px;" title="${row.data.title || ''}">${row.data.title || '<em>(Missing)</em>'}</td>
                <td>${row.data.location || ''}, ${row.data.country || ''}</td>
                <td>&#8377;${Number(row.data.price || 0).toLocaleString("en-IN")}</td>
                <td><span class="badge bg-light text-dark border">${row.data.category || 'Trending'}</span></td>
                <td>${row.data.accommodationType || 'Entire home'}</td>
                <td class="small" style="max-width: 300px; white-space: normal;">${remarks.join("<br/>") || '<span class="text-success"><i class="fa-solid fa-circle-check me-1"></i>Ready for import</span>'}</td>
            `;
            tbody.appendChild(tr);
        });

        // Scroll to preview section
        previewSection.scrollIntoView({ behavior: "smooth" });
    }

    function renderReviewsPreview(result) {
        currentBatchId = result.batchId;
        const section = document.getElementById("reviewsPreviewSection");
        section.classList.remove("d-none");
        document.getElementById("reviewsImportCount").innerText = result.summary.valid;

        const tbody = document.getElementById("reviewsTableBody");
        tbody.innerHTML = "";

        result.preview.forEach(row => {
            const tr = document.createElement("tr");
            const status = row.isValid
                ? '<span class="badge bg-success rounded-pill">Valid</span>'
                : '<span class="badge bg-danger rounded-pill">Invalid</span>';

            tr.innerHTML = `
                <td>${row.rowIndex}</td>
                <td>${status}</td>
                <td>${row.data.listingRef || ''}</td>
                <td><i class="fa-solid fa-star text-warning me-1"></i>${row.data.rating || ''}</td>
                <td class="text-truncate" style="max-width: 250px;">${row.data.comment || ''}</td>
                <td>${row.data.authorRef || 'Current Admin'}</td>
                <td>${row.errors.join("; ") || '<span class="text-success">OK</span>'}</td>
            `;
            tbody.appendChild(tr);
        });
    }

    function filterPreviewRows(filter, btn) {
        // Toggle active button style
        const btnGroup = btn.parentElement;
        btnGroup.querySelectorAll("button").forEach(b => {
            b.classList.remove("btn-dark", "active");
            b.classList.add("btn-outline-secondary");
        });
        btn.classList.add("btn-dark", "active");
        btn.classList.remove("btn-outline-secondary");

        const rows = document.querySelectorAll("#listingsTableBody tr");
        rows.forEach(tr => {
            if (filter === "all") {
                tr.style.display = "";
            } else if (filter === "valid") {
                tr.style.display = tr.classList.contains("table-row-valid") ? "" : "none";
            } else if (filter === "invalid") {
                tr.style.display = tr.classList.contains("table-row-invalid") ? "" : "none";
            } else if (filter === "duplicate") {
                tr.style.display = tr.classList.contains("table-row-duplicate") ? "" : "none";
            }
        });
    }

    function triggerExport(format) {
        const catSelect = document.getElementById("exportCategorySelect");
        const category = catSelect ? catSelect.value : "All";
        window.location.href = `/admin/bulk-import/export?format=${format}&category=${encodeURIComponent(category)}`;
    }
</script>

<style>
    .drop-zone {
        transition: all 0.2s ease-in-out;
        cursor: pointer;
    }
    .drop-zone:hover {
        border-color: #FF385C !important;
        background-color: #fff9f9 !important;
    }
    .table-row-invalid {
        background-color: #fef2f2 !important;
    }
    .table-row-duplicate {
        background-color: #fffbeb !important;
    }
</style>
