<% layout("/layouts/boilerplate") -%>

<div class="row justify-content-center py-5">
    <div class="col-12 col-md-8 col-lg-6 text-center">
        <div class="card border-0 shadow-sm rounded-4 p-5 bg-white">
            <div class="display-1 text-danger mb-3">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <h2 class="fw-bold mb-2">Oops! Something went wrong</h2>
            <p class="text-secondary mb-4"><%= message || "The page you are looking for might have been moved or is temporarily unavailable." %></p>
            <div class="d-flex justify-content-center gap-2">
                <a href="/listings" class="btn btn-danger rounded-pill px-4 py-2 fw-semibold">
                    <i class="fa-solid fa-house me-1"></i> Back to Home
                </a>
                <a href="/feedback" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                    Report Issue
                </a>
            </div>
        </div>
    </div>
</div>