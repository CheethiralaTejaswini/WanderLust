<% layout("/layouts/boilerplate") -%>

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white booking-confirmation-card">
            <!-- Header Banner -->
            <div class="bg-success text-white p-4 text-center">
                <i class="fa-solid fa-circle-check display-3 mb-2"></i>
                <h3 class="fw-bold mb-1">Reservation Confirmed!</h3>
                <p class="mb-0 opacity-75">Your stay is booked and ready. Pack your bags!</p>
            </div>

            <!-- Receipt Body -->
            <div class="card-body p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                    <div>
                        <span class="text-muted small text-uppercase fw-semibold d-block">Reservation Code</span>
                        <span class="fs-4 fw-bold text-dark font-monospace"><%= booking.bookingCode %></span>
                    </div>
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2 fs-6">
                        <%= booking.status %>
                    </span>
                </div>

                <!-- Listing Overview -->
                <div class="d-flex gap-3 align-items-center mb-4 p-3 bg-light rounded-4 border">
                    <img src="<%= booking.listing.image && booking.listing.image.url ? booking.listing.image.url : 'https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=400&q=80' %>"
                         alt="<%= booking.listing.title %>" class="rounded-3 shadow-sm" style="width: 80px; height: 80px; object-fit: cover;">
                    <div class="overflow-hidden">
                        <h6 class="fw-bold mb-1 text-truncate"><%= booking.listing.title %></h6>
                        <p class="text-muted small mb-0 text-truncate"><i class="fa-solid fa-location-dot me-1 text-danger"></i> <%= booking.listing.location %>, <%= booking.listing.country %></p>
                    </div>
                </div>

                <!-- Reservation Details Table -->
                <div class="mb-4">
                    <h6 class="fw-bold mb-3 text-uppercase small text-muted">Stay Details</h6>
                    <div class="row g-2 small">
                        <div class="col-6">
                            <div class="p-2 border rounded-3 bg-light">
                                <span class="text-muted d-block">Check-in</span>
                                <strong><%= new Date(booking.checkIn).toLocaleDateString("en-IN", { weekday: "short", month: "short", day: "numeric", year: "numeric" }) %></strong>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2 border rounded-3 bg-light">
                                <span class="text-muted d-block">Check-out</span>
                                <strong><%= new Date(booking.checkOut).toLocaleDateString("en-IN", { weekday: "short", month: "short", day: "numeric", year: "numeric" }) %></strong>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2 border rounded-3 bg-light">
                                <span class="text-muted d-block">Total Duration</span>
                                <strong><%= booking.totalNights %> <%= booking.totalNights === 1 ? 'Night' : 'Nights' %></strong>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2 border rounded-3 bg-light">
                                <span class="text-muted d-block">Guests</span>
                                <strong><%= booking.guests %> <%= booking.guests === 1 ? 'Guest' : 'Guests' %></strong>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Guest & Payment Info -->
                <div class="mb-4 pb-3 border-bottom small">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted">Primary Guest:</span>
                        <div class="d-flex align-items-center gap-2">
                            <% const gAvatar = (typeof getAvatarUrl === "function") ? getAvatarUrl(booking.guestName, 60) : ""; %>
                            <% if (gAvatar) { %>
                                <img src="<%= gAvatar %>" alt="<%= booking.guestName %>" class="rounded-circle border" style="width: 24px; height: 24px; object-fit: cover;" onerror="this.style.display='none';" />
                            <% } %>
                            <span class="fw-semibold text-dark"><%= booking.guestName %></span>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Contact Email:</span>
                        <span class="fw-semibold text-dark"><%= booking.guestEmail %></span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Payment Method:</span>
                        <span class="fw-semibold text-dark"><%= booking.paymentMethod %></span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Payment Status:</span>
                        <span class="fw-semibold text-success"><%= booking.paymentStatus %></span>
                    </div>
                </div>

                <!-- Price Breakdown -->
                <div class="mb-4">
                    <h6 class="fw-bold mb-3 text-uppercase small text-muted">Price Breakdown</h6>
                    <div class="d-flex justify-content-between text-muted small mb-2">
                        <span>&#8377;<%= Number(booking.nightlyPrice).toLocaleString("en-IN") %> &times; <%= booking.totalNights %> nights</span>
                        <span>&#8377;<%= Number(booking.nightlyPrice * booking.totalNights).toLocaleString("en-IN") %></span>
                    </div>
                    <div class="d-flex justify-content-between text-muted small mb-2">
                        <span>Cleaning fee</span>
                        <span>&#8377;<%= Number(booking.cleaningFee).toLocaleString("en-IN") %></span>
                    </div>
                    <div class="d-flex justify-content-between text-muted small mb-2">
                        <span>Service fee</span>
                        <span>&#8377;<%= Number(booking.serviceFee).toLocaleString("en-IN") %></span>
                    </div>
                    <div class="d-flex justify-content-between fw-bold text-dark fs-5 pt-2 border-top">
                        <span>Total Paid / Due</span>
                        <span>&#8377;<%= Number(booking.totalPrice).toLocaleString("en-IN") %></span>
                    </div>
                </div>

                <!-- Email Voucher Preview (if generated) -->
                <% if (booking.emailPreviewUrl) { %>
                    <div class="p-3 mb-4 rounded-4 bg-light border d-flex align-items-center justify-content-between">
                        <div>
                            <div class="fw-semibold text-dark"><i class="fa-solid fa-envelope-open-text text-danger me-2"></i> Confirmation Email Voucher</div>
                            <div class="text-muted small">Generated for <%= booking.guestEmail %></div>
                        </div>
                        <a href="<%= booking.emailPreviewUrl %>" target="_blank" class="btn btn-sm btn-danger rounded-pill fw-semibold px-3">
                            <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> Open Email
                        </a>
                    </div>
                <% } %>

                <!-- Action Buttons -->
                <div class="d-flex flex-column gap-2">
                    <div class="d-flex gap-2">
                        <button class="btn btn-dark rounded-pill flex-grow-1 py-2 fw-semibold" onclick="window.print();">
                            <i class="fa-solid fa-print me-1"></i> Print Receipt
                        </button>
                        <a href="/profile" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                            My Dashboard
                        </a>
                    </div>
                    
                    <form method="POST" action="/bookings/<%= booking._id %>/resend-email">
                        <button type="submit" class="btn btn-outline-primary rounded-pill w-100 py-2 fw-semibold">
                            <i class="fa-regular fa-envelope me-1"></i> Send / Resend Confirmation Email (<%= booking.guestEmail %>)
                        </button>
                    </form>

                    <a href="/cabs/book?listingId=<%= booking.listing._id %>" class="btn btn-warning rounded-pill py-2 fw-semibold text-dark shadow-sm">
                        <i class="fa-solid fa-taxi me-1"></i> Need a Cab to this Stay?
                    </a>
                </div>

                <!-- Live Gmail Delivery Tip -->
                <div class="mt-4 pt-3 border-top text-center">
                    <small class="text-muted d-block mb-1">
                        <i class="fa-solid fa-circle-info me-1 text-primary"></i> Want live confirmation emails delivered directly to your actual Gmail inbox?
                    </small>
                    <small class="text-muted">
                        Simply add your Gmail and 16-character Google App Password in <code>.env</code> under <code>EMAIL_USER</code> and <code>EMAIL_PASS</code>.
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>
