# Server & Session Secret
PORT=8080
SECRET=your_super_secret_session_key_here
MONGO_URL=mongodb://127.0.0.1:27017/wanderlust

# Cloudinary Credentials (for listing image uploads)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:8080/auth/google/callback

# Google Maps Platform API Key (JavaScript API, Places API, Routes/Directions API)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Automated Email Notifications (Gmail / SMTP App Password)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Optional: Admin Usernames (comma-separated list of usernames with admin access)
ADMIN_USERS=admin,tejaswini

# Optional: Base URL / Production Domain (auto-detected on Render via RENDER_EXTERNAL_URL)
# BASE_URL=https://your-wanderlust-app.onrender.com
# NODE_ENV=production

